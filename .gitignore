# Publish only the reusable harness. A vault's notes and generated state stay local.
/*
!/.gitignore
!/README.md
!/pi-learn
!/.pi/
!/.obsidian/

/.pi/*
!/.pi/agents/
!/.pi/extensions/
!/.pi/skills/
!/.pi/tests/
!/.pi/learning-profile.mjs
!/.pi/learning-launcher.mjs
/.pi/tests/behavioral/

/.obsidian/*
!/.obsidian/snippets/

**/__pycache__/
*.pyc
*.pdf
*.sqlite
*.db
*.log
.DS_Store
